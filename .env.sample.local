# Server config
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://*:5006
Jwt__Issuer=terminal
Jwt__Audience=terminal-clients
Jwt__SecretKey=[super-secret-key-for-development-purposes-only]
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30
Postgres__ConnectionString=Host=database;Database=terminal;Username=root;Password=root;Include Error Detail=true
Administrator__Email=admin@terminal.com
Administrator__Password=password

# Postgres config
POSTGRES_PASSWORD=root
POSTGRES_DB=terminal
POSTGRES_USER=root

# Backup config
RESTIC_PASSWORD=passwd1
RESTIC_SFTP_HOST=192.168.18.13
RESTIC_SFTP_USER=root
RESTIC_SFTP_PORT=22
RESTIC_SFTP_REPO_PATH=/home/root/restic-repo
RESTIC_HOST_SSH_KEY_PATH=/home/anon/.ssh/id_rsa
RESTIC_GDRIVE_RCLONE_REMOTE=gdrive
RESTIC_GDRIVE_REPO_PATH=terminal-backup
RESTIC_HOST_GDRIVE_KEY_PATH=/home/anon/.ssh/gdrive-sa.json
